{
  "name": "modbros_restapi",
  "displayName": "REST API",
  "author": "ModBros",
  "description": "Add your own custom metrics via a simple REST interface",
  "assembly": "Plugin.RestApi.dll",
  "localization": "Resources/Localization",
  "repository": "https://github.com/ModBros/mobro-plugin-restapi",
  "homepage": null,
  "tags": [
    "custom",
    "rest",
    "api"
  ],
  "settings": [
    {
      "type": "number",
      "name": "port",
      "label": "setting.port.label",
      "description": "setting.port.desc",
      "required": true,
      "defaultValue": 8080,
      "min": 0,
      "max": 65535
    },
    {
      "type": "checkbox",
      "name": "swagger_enable",
      "label": "setting.swagger_enable.label",
      "description": "setting.swagger_enable.desc",
      "defaultValue": true,
      "required": false
    },
    {
      "type": "checkbox",
      "name": "persistence_enable",
      "label": "setting.persistence_enable.label",
      "description": "setting.persistence_enable.desc",
      "defaultValue": true,
      "required": false
    }
  ]
}